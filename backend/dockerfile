FROM eclipse-temurin:17-jdk AS build
WORKDIR /app

# 의존성 레이어: gradle wrapper/설정 파일만 먼저 복사. 이 파일들이 안 바뀌는 한
# 아래 `gradlew dependencies` 레이어가 캐시되어, 소스 코드만 바뀐 빌드에서는
# 의존성을 다시 받지 않는다 (전체 COPY . . 뒤에 바로 빌드하면 소스 한 줄만
# 바뀌어도 이 레이어가 무효화되어 매번 전체 의존성을 재다운로드하게 됨).
COPY gradlew gradlew.bat ./
COPY gradle ./gradle
COPY build.gradle settings.gradle ./
RUN chmod +x ./gradlew
RUN ./gradlew --no-daemon dependencies || true

# 소스 전체 복사 후 실제 빌드 — 의존성은 위 레이어 캐시를 재사용
COPY . .
RUN chmod +x ./gradlew
RUN ./gradlew --no-daemon clean bootJar -x test

# 2단계: 실행 이미지 (최소한의 경량 이미지)
FROM eclipse-temurin:17-jdk
WORKDIR /app

# 빌드 산출물만 런타임 이미지로 복사
COPY --from=build /app/build/libs/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar app.jar"]
