# Disaster Alert Archive — 환경변수 템플릿
#
# 실제 값을 채운 뒤 용도에 맞는 파일명으로 복사해서 사용한다 (전부 gitignore 대상):
#   - backend/.env.test : 백엔드 통합 테스트(@ExtendWith(DotenvExtension.class))가 로드
#   - .env.dev          : docker-compose.dev.yml 의 backend/postgres 서비스가 로드
#   - .env              : docker-compose.prod.yml 의 backend 서비스가 로드 (운영 값)
#
# 로컬 개발 시 Postgres/Redis만 compose로 띄우고(docker compose -f docker-compose.dev.yml up
# postgres redis) 백엔드/프론트는 직접 실행하는 경우, DB_HOST/REDIS_HOST는 localhost로 둔다.
#
# 이 파일은 "백엔드"용이다. 프론트엔드 환경변수는 frontend/.env.local.example 를 쓴다.
# 여기 없는 설정 중 반드시 필요한 것 하나: FCM 발송용 서비스 계정 키를
# backend/src/main/resources/firebase-service-account.json 에 두어야 한다 (환경변수가 아니라
# 클래스패스 파일로 읽는다 — global/config/FirebaseConfig 참고).
#
# 항목을 추가/변경할 때는 backend/src/main/resources/application.yml 의 ${...} 참조를 기준으로 한다.

# ─── Postgres ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=disaster_alert
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT (HS256 — 32바이트 이상) ───────────────────────
JWT_SECRET=

# ─── 쿠키 (운영에서만 설정, 로컬은 비워둠) ──────────────
COOKIE_DOMAIN=

# ─── 메일(Gmail SMTP) ──────────────────────────────────
GMAIL_USERNAME=
GMAIL_PASSWORD=

# ─── 재난문자 공공데이터포털 API ───────────────────────
DISASTER_ALERT_SERVICE_KEY=

# ─── 기상청 초단기실황 API ─────────────────────────────
KMA_ASOS_API_KEY=

# ─── Spring AI (OpenAI) ────────────────────────────────
# 임베딩(text-embedding-3-small)·LLM 판정(gpt-4o-mini)·번역(gpt-4o)이 이 키 하나를 공유한다.
OPENAI_API_KEY=

# ─── 번역 (엔진은 OpenAI, 전용 키 없음 — 위 OPENAI_API_KEY 공유) ──
# false 로 두면 번역을 시도하지 않고 원문(한국어)을 그대로 노출한다. 미설정 시 true.
TRANSLATION_ENABLED=true

# ─── OAuth2 (Google/Kakao/Naver 자체 구현) ─────────────
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/kakao/callback

NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/naver/callback

# ─── 이벤트 클러스터링 기능 플래그 (미설정 시 전부 false) ──
# CLUSTERING_ENABLED      : 임베딩 기반 클러스터링 전체 on/off
# LLM_FALLBACK_ENABLED    : borderline 병합 판정을 LLM 에 위임 (호출당 비용 발생)
# CROSS_REGION_ENABLED    : 실종자·탈출 동물 등 지역을 넘나드는 알림의 별도 병합 패스
CLUSTERING_ENABLED=false
LLM_FALLBACK_ENABLED=false
CROSS_REGION_ENABLED=false

# ─── Sentry 에러 트래킹 (sentry.io 가입 후 프로젝트 DSN 발급, 무료 티어) ──
# 비워두면 SDK 가 자동 no-op 처리됨
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# ─── docker-compose.prod.yml 전용 ──────────────────────
# DOCKER_USER=
# API_TAG=latest
