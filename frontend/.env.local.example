# Disaster Alert Archive — 프론트엔드 환경변수 템플릿
#
# 실제 값을 채운 뒤 frontend/.env.local 로 복사해서 사용한다 (gitignore 대상).

# ─── API 베이스 URL ─────────────────────────────────────
# BASE_API_URL: 서버 런타임(SSR/generateMetadata) 전용, 브라우저에 노출되지 않음
BASE_API_URL=http://localhost:8080
# NEXT_PUBLIC_API_URL / NEXT_PUBLIC_API_BASE_URL: 브라우저(axios/OAuth 리다이렉트)에서 사용
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=

# ─── Firebase (FCM 푸시 알림) ───────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ─── 분석·검색 노출 (선택) ──────────────────────────────
# 비워 두면 해당 태그를 넣지 않는다. 빌드 시점에 번들/HTML에 인라인되므로 값을 바꾸면 다시 빌드해야 한다.
# GA4 측정 ID (예: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity 프로젝트 ID (히트맵·세션 녹화, clarity.microsoft.com 에서 발급)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# 구글 서치콘솔 HTML 태그 방식 확인 코드 (DNS TXT 로 확인했다면 비워 둠)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 HTML 태그 방식 확인 코드
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
