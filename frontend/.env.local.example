# Disaster Alert Archive — 프론트엔드 환경변수 템플릿
#
# 실제 값을 채운 뒤 frontend/.env.local 로 복사해서 사용한다 (gitignore 대상).

# ─── API 베이스 URL ─────────────────────────────────────
# BASE_API_URL: 서버 런타임(SSR/generateMetadata) 전용, 브라우저에 노출되지 않음
BASE_API_URL=http://localhost:8080
# NEXT_PUBLIC_API_URL / NEXT_PUBLIC_API_BASE_URL: 브라우저(axios/OAuth 리다이렉트)에서 사용
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=

# ─── 카카오맵 ───────────────────────────────────────────
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# ─── Firebase (FCM 푸시 알림) ───────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
